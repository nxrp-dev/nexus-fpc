// Shared compiler settings; compilation inputs belong to the consuming project.
Project ToolSettings {
    Id: "NXRP.NXPC.Settings.ToolSettings";
    NXPC Options {
        CompilerPath: $NativeCompiler;
        Assembler LLVM HostOS[linux] { OutputFormat: "as-clang"; }

        OutputPath: $BootstrapRoot + "/tools/units/common";
        Config Options { DisableDefaultConfigFiles: True; OptionFiles: [$BootstrapRoot + "/seed/build-options.cfg"]; }
        Syntax PascalSyntax { COperators: Disabled; }
        Optimization Optimize { Level: Level2; }
        Units UnitOptions { GenerateReleaseUnitFiles: Enabled; }
        Linking Link { StripSymbols: Enabled; }
        RawOptions: ["-FE" + $BootstrapRoot + "/tools/bin"];
        Files Paths {
            UnitPaths: [
                $NativeRTL,
                $BootstrapRoot + "/tools/packages/rtl-objpas/src/inc",
                $BootstrapRoot + "/tools/packages/rtl-objpas/src/" + $HostRTLPlatform,
                $BootstrapRoot + "/tools/packages/fcl-base/src",
                $BootstrapRoot + "/tools/packages/fcl-base/src/" + $HostRTLPlatform,
                $BootstrapRoot + "/tools/packages/fcl-json/src",
                $BootstrapRoot + "/tools/packages/paszlib/src"
            ];
            IncludePaths: [
                $BootstrapRoot + "/tools/packages/rtl-objpas/src/inc",
                $BootstrapRoot + "/tools/packages/rtl-objpas/src/" + $HostRTLPlatform,
                $BootstrapRoot + "/tools/packages/rtl-objpas/src/x86_64",
                $BootstrapRoot + "/tools/packages/fcl-base/src",
                $BootstrapRoot + "/tools/packages/fcl-base/src/" + $HostRTLPlatform,
                $BootstrapRoot + "/tools/packages/fcl-base/src/dummy"
            ];
        }
    }
}
