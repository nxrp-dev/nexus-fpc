dialect "../../../nexus/projects/nxbuild/language/nxbuild.Language.nxscript";
module LinuxSettings "Linux.Settings.nxscript";

Project Linux {
    Id: "NXRP.NXPC.cross.Linux";
    RootDirectory: $BootstrapRoot;
    LLVM BuildAbiTag TargetCPU[x86_64] {
        BuildKind: Object;
        SourceFiles: [
            $BootstrapRoot + "/seed/rtl/linux/x86_64/abitag.as"
        ];
        OutputPath: $CrossRTL;
        Target: $Triple;
        RawOptions: ["-x", "assembler", "-o" + $CrossRTL + "/abitag.o"];
    }
    LLVM Buildprt0 TargetCPU[aarch64] {
        BuildKind: Object;
        SourceFiles: [
            $BootstrapRoot + "/seed/rtl/linux/aarch64/prt0.as"
        ];
        OutputPath: $CrossRTL;
        Target: $Triple;
        RawOptions: ["-x", "assembler", "-o" + $CrossRTL + "/prt0.o"];
    }
    LLVM Builddllprt0 TargetCPU[aarch64] {
        BuildKind: Object;
        SourceFiles: [
            $BootstrapRoot + "/seed/rtl/linux/aarch64/dllprt0.as"
        ];
        OutputPath: $CrossRTL;
        Target: $Triple;
        RawOptions: ["-x", "assembler", "-o" + $CrossRTL + "/dllprt0.o"];
    }
    LLVM Buildcprt0 TargetCPU[aarch64] {
        BuildKind: Object;
        SourceFiles: [
            $BootstrapRoot + "/seed/rtl/linux/aarch64/cprt0.as"
        ];
        OutputPath: $CrossRTL;
        Target: $Triple;
        RawOptions: ["-x", "assembler", "-o" + $CrossRTL + "/cprt0.o"];
    }

    NXPC System (LinuxSettings.Options) {
        SourceFiles: [
            $BootstrapRoot + "/seed/rtl/linux/system.pas"
        ];
        Syntax PascalSyntax { COperators: Disabled; LabelAndGoto: Enabled; }
        Units UnitOptions { GenerateReleaseUnitFiles: Enabled; CompileSystemUnit: Enabled; }
    }

    NXPC ObjPas (LinuxSettings.Options) {
        SourceFiles: [
            $BootstrapRoot + "/seed/rtl/objpas/objpas.pas"
        ];
    }

    NXPC Startup (LinuxSettings.Options) TargetCPU[i386, x86_64] {
        SourceFiles: [
            $BootstrapRoot + "/seed/rtl/linux/si_prc.pas",
            $BootstrapRoot + "/seed/rtl/linux/si_c.pas",
            $BootstrapRoot + "/seed/rtl/linux/si_dll.pas"
        ];
    }

    NXPC I386Startup (LinuxSettings.Options) TargetCPU[i386] {
        SourceFiles: [
            $BootstrapRoot + "/seed/rtl/linux/si_c21.pas",
            $BootstrapRoot + "/seed/rtl/linux/si_uc.pas"
        ];
    }

    NXPC Core (LinuxSettings.Options) {
        SourceFiles: [
            $BootstrapRoot + "/seed/rtl/" + $TargetCPU + "/intrinsics.pas",
            $BootstrapRoot + "/seed/rtl/inc/fpintres.pas",
            $BootstrapRoot + "/seed/rtl/inc/uuchar.pas",
            $BootstrapRoot + "/seed/rtl/unix/unixtype.pas",
            $BootstrapRoot + "/seed/rtl/inc/ctypes.pas",
            $BootstrapRoot + "/seed/rtl/unix/baseunix.pas",
            $BootstrapRoot + "/seed/rtl/inc/strings.pas",
            $BootstrapRoot + "/seed/rtl/inc/macpas.pas",
            $BootstrapRoot + "/seed/rtl/inc/iso7185.pas",
            $BootstrapRoot + "/seed/rtl/unix/syscall.pas",
            $BootstrapRoot + "/seed/rtl/unix/unixutil.pas",
            $BootstrapRoot + "/seed/rtl/inc/heaptrc.pas",
            $BootstrapRoot + "/seed/rtl/inc/lnfodwrf.pas",
            $BootstrapRoot + "/seed/rtl/linux/termio.pas",
            $BootstrapRoot + "/seed/rtl/unix/unix.pas",
            $BootstrapRoot + "/seed/rtl/linux/linux.pas",
            $BootstrapRoot + "/seed/rtl/unix/initc.pas",
            $BootstrapRoot + "/seed/rtl/inc/cmem.pas",
            $BootstrapRoot + "/seed/rtl/linux/linuxvcs.pas",
            $BootstrapRoot + "/seed/rtl/unix/sysutils.pas"
        ];
    }

    NXPC TypInfo (LinuxSettings.Options) {
        SourceFiles: [
            $BootstrapRoot + "/seed/rtl/objpas/typinfo.pas"
        ];
        Syntax PascalSyntax { COperators: Disabled; LabelAndGoto: Enabled; }
    }

    NXPC Runtime (LinuxSettings.Options) {
        SourceFiles: [
            $BootstrapRoot + "/seed/rtl/objpas/math.pas",
            $BootstrapRoot + "/seed/rtl/inc/charset.pas",
            $BootstrapRoot + "/seed/rtl/charmaps/cpall.pas",
            $BootstrapRoot + "/seed/rtl/objpas/character.pas",
            $BootstrapRoot + "/seed/rtl/unix/unixcp.pas",
            $BootstrapRoot + "/seed/rtl/inc/getopts.pas",
            $BootstrapRoot + "/seed/rtl/unix/errors.pas",
            $BootstrapRoot + "/seed/rtl/unix/dl.pas",
            $BootstrapRoot + "/seed/rtl/inc/dynlibs.pas",
            $BootstrapRoot + "/seed/rtl/objpas/types.pas",
            $BootstrapRoot + "/seed/rtl/objpas/sysconst.pas",
            $BootstrapRoot + "/seed/rtl/objpas/fpwidestring.pas",
            $BootstrapRoot + "/seed/rtl/unix/cthreads.pas",
            $BootstrapRoot + "/seed/rtl/inc/sortbase.pas",
            $BootstrapRoot + "/seed/rtl/unix/classes.pas",
            $BootstrapRoot + "/seed/rtl/objpas/rtlconsts.pas",
            $BootstrapRoot + "/seed/rtl/unix/dos.pas",
            $BootstrapRoot + "/seed/rtl/unix/cwstring.pas",
            $BootstrapRoot + "/seed/rtl/unix/unix98pty.pas"
        ];
    }

    NXPC X86Runtime (LinuxSettings.Options) TargetCPU[i386, x86_64] {
        SourceFiles: [
            $BootstrapRoot + "/seed/rtl/" + $TargetCPU + "/cpu.pas",
            $BootstrapRoot + "/seed/rtl/unix/ports.pas",
            $BootstrapRoot + "/seed/rtl/unix/x86.pas"
        ];
    }

    NXPC MMX (LinuxSettings.Options) TargetCPU[i386] {
        SourceFiles: [
            $BootstrapRoot + "/seed/rtl/i386/mmx.pas"
        ];
    }
}
