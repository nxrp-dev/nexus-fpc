// Shared compiler settings; compilation inputs belong to the consuming project.
Project AndroidSettings {
    Id: "NXRP.NXPC.Settings.AndroidSettings";
    NXPC Options {
        CompilerPath: $CrossCompiler;
        OutputPath: $CrossRTL;
        Config Options { DisableDefaultConfigFiles: True; OptionFiles: [$BootstrapRoot + "/seed/build-options.cfg"]; }
        Syntax PascalSyntax { COperators: Disabled; }
        Assembler LLVM { OutputFormat: "as-clang"; }
        Optimization Optimize { Level: Level2; }
        Units UnitOptions { GenerateReleaseUnitFiles: Enabled; }
        Target Platform { OperatingSystem: $TargetOS; }
        CodeGeneration Code { PositionIndependentCode: Enabled; }
        RawOptions: ["-XLL"];
        Files Paths {
            CompilerUtilitiesPath: $HostLLVMDirectory;
            UnitPaths: [
                $CrossRTL,
                $BootstrapRoot + "/seed/rtl/android",
                $BootstrapRoot + "/seed/rtl/linux",
                $BootstrapRoot + "/seed/rtl/unix",
                $BootstrapRoot + "/seed/rtl/inc",
                $BootstrapRoot + "/seed/rtl/objpas",
                $BootstrapRoot + "/seed/rtl/" + $TargetCPU,
                $BootstrapRoot + "/seed/rtl/linux/" + $TargetCPU
            ];
            IncludePaths: [
                $BootstrapRoot + "/seed/rtl/android",
                $BootstrapRoot + "/seed/rtl/inc",
                $BootstrapRoot + "/seed/rtl/" + $TargetCPU,
                $BootstrapRoot + "/seed/rtl/unix",
                $BootstrapRoot + "/seed/rtl/android/" + $TargetCPU,
                $BootstrapRoot + "/seed/rtl/linux",
                $BootstrapRoot + "/seed/rtl/linux/" + $TargetCPU,
                $BootstrapRoot + "/seed/rtl/objpas",
                $BootstrapRoot + "/seed/rtl/objpas/sysutils",
                $BootstrapRoot + "/seed/rtl/objpas/classes",
                $BootstrapRoot + "/seed/rtl/charmaps"
            ];
        }
    }
}
