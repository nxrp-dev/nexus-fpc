// Win64 runtime-package SDK, using the completed native bootstrap.

Group RuntimePackageSDK {
    CompareFiles RequireCompletedBootstrap {
        Left: "build/forge-bootstrap/cycle2/ppcx64.exe";
        Right: "build/forge-bootstrap/cycle3/ppcx64.exe";
    }
    DeletePath CleanPackageSDK { Path: "build/forge-bootstrap/package-sdk"; Recursive: True; }
    CopyFile Compiler {
        Source: "build/forge-bootstrap/cycle3/ppcx64.exe";
        Destination: "build/forge-bootstrap/package-sdk/bin/ppcx64.exe";
    }
    CopyFile MatchingRTL {
        Source: "build/forge-bootstrap/cycle3/rtl64";
        Destination: "build/forge-bootstrap/package-sdk/work/rtl-units";
        Recursive: True;
        IncludeMasks: ["*.nxu", "*.o", "*.a", "*.res", "*.rsj"];
        ExcludeNames: "buildrtl.nxu;buildrtl.o";
    }
    CopyFile FoundationDeclaration {
        Source: "build/forge-bootstrap/seed/rtl/win64/nxrtl.nxpk";
        Destination: "build/forge-bootstrap/package-sdk/work/nxrtl/nxrtl.nxpk";
    }
    CopyFile StartupSource {
        Source: "build/forge-bootstrap/seed/rtl/win64/sysinitpkg.pas";
        Destination: "build/forge-bootstrap/package-sdk/work/sysinitpkg.pas";
    }
    PackageSDKOptions PackageIdentity {
        BootstrapDirectory: "build/forge-bootstrap";
        OutputDirectory: "build/forge-bootstrap/package-sdk";
    }
    FPC SharedRTL {
        Template: "../../nexus/projects/forge/examples/FPC.mustache";
        Compiler: "build/forge-bootstrap/package-sdk/bin/ppcx64.exe";
        Source: ["build/forge-bootstrap/package-sdk/work/nxrtl/nxrtl.nxpk"];
        EntryPoint: "build/forge-bootstrap/package-sdk/work/nxrtl/nxrtl.nxpk";
        Output: "build/forge-bootstrap/package-sdk/work/nxrtl/nxrtl.nxpl";
        UnitOutput: "build/forge-bootstrap/package-sdk/work/nxrtl";
        UnitPaths: ["build/forge-bootstrap/package-sdk/work/rtl-units", "build/forge-bootstrap/seed/rtl/inc"];
        ResponseFiles: ["build/forge-bootstrap/seed/build-options.cfg", "build/forge-bootstrap/package-sdk/work/foundation.cfg"];
        Mode: "objfpc";
        DisableDefaultConfigFiles: True;
        OptimizationLevel: 2;
        GenerateReleaseUnitFiles: True;
        StripSymbols: True;
    }
    CopyFile FoundationImage {
        Source: "build/forge-bootstrap/package-sdk/work/nxrtl/nxrtl.nxpl";
        Destination: "build/forge-bootstrap/package-sdk/packages/nxrtl.nxpl";
    }
    CopyFile PerImageResourceAdapter {
        Source: "build/forge-bootstrap/package-sdk/work/rtl-units";
        Destination: "build/forge-bootstrap/package-sdk/units";
        Recursive: True;
        IncludeMasks: ["fpintres.nxu", "fpintres.o", "libimpfpintres.a"];
    }
    FPC HostStartup {
        Template: "../../nexus/projects/forge/examples/FPC.mustache";
        Compiler: "build/forge-bootstrap/package-sdk/bin/ppcx64.exe";
        Source: ["build/forge-bootstrap/package-sdk/work/sysinitpkg.pas"];
        EntryPoint: "build/forge-bootstrap/package-sdk/work/sysinitpkg.pas";
        UnitOutput: "build/forge-bootstrap/package-sdk/units";
        UnitPaths: ["build/forge-bootstrap/package-sdk/units"];
        LibraryPaths: ["build/forge-bootstrap/package-sdk/packages"];
        ResponseFiles: ["build/forge-bootstrap/seed/build-options.cfg", "build/forge-bootstrap/package-sdk/work/startup.cfg"];
        Mode: "objfpc";
        DisableDefaultConfigFiles: True;
        OptimizationLevel: 2;
        GenerateReleaseUnitFiles: True;
    }
    CopyFile ConsumerBuild {
        Source: "../../nexus/projects/forge/examples/PackageBuild.nxscript";
        Destination: "build/forge-bootstrap/package-sdk/forge/PackageBuild.nxscript";
    }
    CopyFile ConsumerCompilerTemplate {
        Source: "../../nexus/projects/forge/examples/FPC.mustache";
        Destination: "build/forge-bootstrap/package-sdk/forge/FPC.mustache";
    }
    PackageSDKManifest SDKManifest {
        Directory: "build/forge-bootstrap/package-sdk";
    }
}
