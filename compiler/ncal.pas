          property followed_by_stack_tainting_call_cached: boolean read ffollowed_by_stack_tainting_call_cached;
          property paracopyback: TNode read fparacopyback;
       end;
       TCallParaNodeClass = class of TCallParaNode;

       TDispCallType = (
