    Function TAICPUAbstract.getcopy:TLinkedListItem;
      var
        i : LongInt;
        p : TAICPUAbstract;
      begin
        p:=TAICPUAbstract(inherited getcopy);
        { make a copy of the references }
        p.opercnt:=0;
        p.allocate_oper(ops);
        for i:=0 to ops-1 do
          begin
            p.oper[i]^:=oper[i]^;
            case oper[i]^.typ of
              top_local :
                begin
                  new(p.oper[i]^.localoper);
                  p.oper[i]^.localoper^:=oper[i]^.localoper^;
                end;
              top_ref :
                begin
                  new(p.oper[i]^.ref);
                  p.oper[i]^.ref^:=oper[i]^.ref^;
                  if Assigned(p.oper[i]^.ref^.symbol) then
                    p.oper[i]^.ref^.symbol.increfs;
                  if Assigned(p.oper[i]^.ref^.relsymbol) then
                    p.oper[i]^.ref^.relsymbol.increfs;
                end;
              else
                ;
            end;
          end;
        getcopy:=p;
      end;


