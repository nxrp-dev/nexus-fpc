# NexusFPC Windows-hosted release. Paths follow the compiler after relocation.
# LLVM tools must be on PATH. Supply platform SDK/sysroot options when needed.
-Fu%basepath%/units/$FPCTARGET/rtl
-FD$FPCBINDIR
-Aas-clang
-XLL
#IFDEF ANDROID
-Cg
#ENDIF
