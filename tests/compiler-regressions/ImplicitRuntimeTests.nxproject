dialect "../../../nexus/projects/nxbuild/language/nxbuild.Language.nxscript";
module Projects "../../../nexus/projects/nxbuild/Projects.nxscript";
module "../../../nexus/projects/nxbuild/nxbuild.environment.nxscript";
Project ImplicitRuntimeTests TargetOS[linux] {
    Id: "NXRP.CompilerTests.ImplicitRuntime";
    Requires: [@Projects.NexusRTL, @Projects.FCLProcess, @Projects.NexusTest];
    RootDirectory: "../../../nexus";
    OutputRoot: @Tools.OutputRoot + "/ImplicitRuntimeTests/" + @Tools.Native.Name + "/" + $BuildConfiguration;
    FPC Tests {
        CompilerPath: @Tools.Native.FPCCompiler;
        SourceFiles: [@Tools.NexusFPC.SourcePath + "/tests/compiler-regressions/ImplicitRuntimeTests.lpr"];
        OutputPath: @ImplicitRuntimeTests.OutputRoot;
        Config Options { DisableDefaultConfigFiles: True; }
        Assembler LLVM { OutputFormat: "as-clang"; }
        Files Paths { CompilerUtilitiesPath: @Tools.Native.CompilerUtilitiesPath; }
    }
}
