dialect "../../../nexus/projects/nxbuild/language/nxbuild.Language.nxscript";
module Projects "../../../nexus/projects/nxbuild/Projects.nxscript";
module "../../../nexus/projects/nxbuild/nxbuild.environment.nxscript";
Project RTLRegressionTests {
    Id: "NXRP.CompilerTests.RTLRegressionTests";
    Requires: [@Projects.NexusTest, @Projects.FCLProcess, @Projects.FCLBase];
    RootDirectory: "../../../nexus";
    OutputRoot: @Tools.OutputRoot + "/RTLRegressionTests/" + @Tools.Native.Name;
 NXPC Tests {
  CompilerPath: @Tools.Native.NXPCCompiler;
  SourceFiles: [@Tools.NXPC.SourcePath + "/tests/rtl/RTLRegressionTests.lpr"];
  OutputPath: @RTLRegressionTests.OutputRoot;
  Config Options { DisableDefaultConfigFiles: True; }
  Language Pascal { Mode: ObjFPC; }
  Assembler Native TargetOS[linux] { OutputFormat: "as-clang"; }
  Files Paths {
   CompilerUtilitiesPath: @Tools.Native.CompilerUtilitiesPath;
   UnitPaths: [
       @Tools.Native.RTLPath,
       @Tools.NXPC.SourcePath + "/tests/rtl",
       @Tools.NXPC.SourcePath + "/tests/utils",
       @Tools.NXPC.SourcePath + "/packages/rtl-objpas/src/inc"
   ];
   IncludePaths: [@Tools.NXPC.SourcePath + "/packages/rtl-objpas/src/" + @Tools.Native.PascalPlatform, @Tools.NXPC.SourcePath + "/packages/rtl-objpas/src/x86_64"];
  }
 }
}
