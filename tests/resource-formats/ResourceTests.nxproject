dialect "../../../nexus/projects/nxbuild/language/nxbuild.Language.nxscript";
module "../../../nexus/projects/nxbuild/nxbuild.environment.nxscript";
Project ResourceTests {
 RootDirectory: "../../../nexus";
 OutputRoot: @Tools.OutputRoot + "/nexus-fpc-tests/" + @Tools.Native.Name + "/resources";
 FPC Tests {
  CompilerPath: @Tools.Native.FPCCompiler;
  SourceFiles: [@Tools.NexusFPC.SourcePath + "/tests/resource-formats/ResourceTests.lpr"];
  OutputPath: @ResourceTests.OutputRoot;
  Config Options { DisableDefaultConfigFiles: True; }
  Language Pascal { Mode: ObjFPC; }
  Assembler Native TargetOS[linux] { OutputFormat: "as-clang"; }
  Files Paths {
   CompilerUtilitiesPath: @Tools.Native.CompilerUtilitiesPath;
   UnitPaths: [@Tools.Native.RTLPath, @Tools.NexusFPC.SourcePath + "/compiler", @Tools.NexusFPC.SourcePath + "/tests/resource-formats", "packages/nexus-packages/nxtest/src", "packages/nexus-packages/fcl-process/src", "packages/nexus-packages/fcl-base/src", @Tools.NexusFPC.SourcePath + "/packages/rtl-objpas/src/inc"];
   IncludePaths: ["packages/nexus-packages/fcl-process/src/" + @Tools.Native.PascalPlatform, "packages/nexus-packages/fcl-base/src/" + @Tools.Native.PascalPlatform, "packages/nexus-packages/fcl-base/src/dummy", @Tools.NexusFPC.SourcePath + "/packages/rtl-objpas/src/" + @Tools.Native.PascalPlatform, @Tools.NexusFPC.SourcePath + "/packages/rtl-objpas/src/x86_64"];
  }
 }
}
