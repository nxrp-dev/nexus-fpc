dialect "../../../nexus/projects/nxbuild/language/nxbuild.Language.nxscript";
module Projects "../../../nexus/projects/nxbuild/Projects.nxscript";
module "../../../nexus/projects/nxbuild/nxbuild.environment.nxscript";

Project NXPackageLifecycleTests {
    Id: "NXRP.CompilerTests.NXPackageLifecycleTests";
    Requires: [@Projects.NexusTest];
    RootDirectory: "../../../nexus";
    OutputRoot: @Tools.OutputRoot + "/NXPackageLifecycleTests/" + @Tools.Native.Name;

    NXPC Tests {
        CompilerPath: @Tools.Native.NXPCCompiler;
        SourceFiles: ["../nexus-fpc/tests/dynamic-packages/NXPackageLifecycleTests.lpr"];
        OutputPath: @NXPackageLifecycleTests.OutputRoot;
        RawOptions: ["-O2", "-gl", "-Cr", "-Co", "-Ci"];
        Config Options { DisableDefaultConfigFiles: True; }
        Assembler Native TargetOS[linux] { OutputFormat: "as-clang"; }
        Files Paths {
            CompilerUtilitiesPath: @Tools.Native.CompilerUtilitiesPath;
            UnitPaths: [
                @Tools.Native.RTLPath,
                "../nexus-fpc/tests/compiler-regressions",
                "../nexus-fpc/compiler",
                "../nexus-fpc/rtl/objpas",
                "../nexus-fpc/rtl/inc"
            ];
        }
    }
}
