dialect "../../../nexus/projects/nxbuild/language/nxbuild.Language.nxscript";
module Projects "../../../nexus/projects/nxbuild/Projects.nxscript";
module "../../../nexus/projects/nxbuild/nxbuild.environment.nxscript";

Project CompilerRecompileTests {
    Id: "NXRP.CompilerTests.CompilerRecompileTests";
    Requires: [@Projects.FCLProcess, @Projects.FCLBase, @Projects.NexusTest];
    RootDirectory: "../../../nexus";
    OutputRoot: @Tools.OutputRoot + "/CompilerRecompileTests/" + @Tools.Native.Name;
    NXPC Tests {
        CompilerPath: @Tools.Native.NXPCCompiler;
        SourceFiles: [@Tools.NXPC.SourcePath + "/tests/tppu/CompilerRecompileTests.lpr"];
        OutputPath: @CompilerRecompileTests.OutputRoot;
        Config Options { DisableDefaultConfigFiles: True; }
        Language Pascal { Mode: ObjFPC; }
        Assembler Native TargetOS[linux] { OutputFormat: "as-clang"; }
        Files Paths {
            CompilerUtilitiesPath: @Tools.Native.CompilerUtilitiesPath;
            UnitPaths: [
                @Tools.Native.RTLPath,
                @Tools.NXPC.SourcePath + "/tests/tppu",
                @Tools.NXPC.SourcePath + "/packages/rtl-objpas/src/inc",
                @Tools.NXPC.SourcePath + "/packages/rtl-objpas/src/" + @Tools.Native.PascalPlatform,
                @Tools.NXPC.SourcePath + "/tests/utils"
            ];
            IncludePaths: [
                @Tools.NXPC.SourcePath + "/packages/rtl-objpas/src/" + @Tools.Native.PascalPlatform,
                @Tools.NXPC.SourcePath + "/packages/rtl-objpas/src/x86_64"
            ];
        }
    }
}
