// Assemble completed Windows-hosted builds; package selection remains separate.

Group ReleaseAssembly {
    Run CheckReleaseInputs {
        Template: "../../nexus/projects/forge/templates/Run.mustache";
        Executable: "powershell.exe";
        Arguments: ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "tests/forge/Test-ReleaseDistribution.ps1", "-SourceRoot", ".", "-InputsOnly"];
    }
    DeletePath CleanDistribution { Path: "build/forge-bootstrap/distribution"; Recursive: True; }
    DeletePath CleanReleaseChecks { Path: "build/forge-bootstrap/release-checks"; Recursive: True; }
    CopyFile HostTools {
        Source: "build/forge-bootstrap/tools/bin";
        Destination: "build/forge-bootstrap/distribution/bin/x86_64-win64";
        Recursive: True;
        IncludeMasks: ["*.exe"];
    }
    CopyFile I386Compiler {
        Source: "build/forge-bootstrap/cross/i386-linux/ppcross386.exe";
        Destination: "build/forge-bootstrap/distribution/bin/x86_64-win64/ppcross386.exe";
    }
    CopyFile AArch64Compiler {
        Source: "build/forge-bootstrap/cross/aarch64-linux/ppcrossa64.exe";
        Destination: "build/forge-bootstrap/distribution/bin/x86_64-win64/ppcrossa64.exe";
    }
    CopyFile RTL_i386_linux {
        Source: "build/forge-bootstrap/cross/i386-linux/rtl";
        Destination: "build/forge-bootstrap/distribution/units/i386-linux/rtl";
        Recursive: True;
        IncludeMasks: ["*.nxu", "*.o", "*.a", "*.res", "*.rsj"];
        ExcludeNames: "buildrtl.nxu;buildrtl.o";
    }
    CopyFile RTL_x86_64_linux {
        Source: "build/forge-bootstrap/cross/x86_64-linux/rtl";
        Destination: "build/forge-bootstrap/distribution/units/x86_64-linux/rtl";
        Recursive: True;
        IncludeMasks: ["*.nxu", "*.o", "*.a", "*.res", "*.rsj"];
        ExcludeNames: "buildrtl.nxu;buildrtl.o";
    }
    CopyFile RTL_aarch64_linux {
        Source: "build/forge-bootstrap/cross/aarch64-linux/rtl";
        Destination: "build/forge-bootstrap/distribution/units/aarch64-linux/rtl";
        Recursive: True;
        IncludeMasks: ["*.nxu", "*.o", "*.a", "*.res", "*.rsj"];
        ExcludeNames: "buildrtl.nxu;buildrtl.o";
    }
    CopyFile RTL_i386_win32 {
        Source: "build/forge-bootstrap/cross/i386-win32/rtl";
        Destination: "build/forge-bootstrap/distribution/units/i386-win32/rtl";
        Recursive: True;
        IncludeMasks: ["*.nxu", "*.o", "*.a", "*.res", "*.rsj"];
        ExcludeNames: "buildrtl.nxu;buildrtl.o";
    }
    CopyFile RTL_x86_64_win64 {
        Source: "build/forge-bootstrap/cross/x86_64-win64/rtl";
        Destination: "build/forge-bootstrap/distribution/units/x86_64-win64/rtl";
        Recursive: True;
        IncludeMasks: ["*.nxu", "*.o", "*.a", "*.res", "*.rsj"];
        ExcludeNames: "buildrtl.nxu;buildrtl.o";
    }
    CopyFile RTL_aarch64_win64 {
        Source: "build/forge-bootstrap/cross/aarch64-win64/rtl";
        Destination: "build/forge-bootstrap/distribution/units/aarch64-win64/rtl";
        Recursive: True;
        IncludeMasks: ["*.nxu", "*.o", "*.a", "*.res", "*.rsj"];
        ExcludeNames: "buildrtl.nxu;buildrtl.o";
    }
    CopyFile RTL_x86_64_android {
        Source: "build/forge-bootstrap/cross/x86_64-android/rtl";
        Destination: "build/forge-bootstrap/distribution/units/x86_64-android/rtl";
        Recursive: True;
        IncludeMasks: ["*.nxu", "*.o", "*.a", "*.res", "*.rsj"];
        ExcludeNames: "buildrtl.nxu;buildrtl.o";
    }
    CopyFile RTL_aarch64_android {
        Source: "build/forge-bootstrap/cross/aarch64-android/rtl";
        Destination: "build/forge-bootstrap/distribution/units/aarch64-android/rtl";
        Recursive: True;
        IncludeMasks: ["*.nxu", "*.o", "*.a", "*.res", "*.rsj"];
        ExcludeNames: "buildrtl.nxu;buildrtl.o";
    }
    CopyFile RTL_x86_64_darwin {
        Source: "build/forge-bootstrap/cross/x86_64-darwin/rtl";
        Destination: "build/forge-bootstrap/distribution/units/x86_64-darwin/rtl";
        Recursive: True;
        IncludeMasks: ["*.nxu", "*.o", "*.a", "*.res", "*.rsj"];
        ExcludeNames: "buildrtl.nxu;buildrtl.o";
    }
    CopyFile RTL_aarch64_darwin {
        Source: "build/forge-bootstrap/cross/aarch64-darwin/rtl";
        Destination: "build/forge-bootstrap/distribution/units/aarch64-darwin/rtl";
        Recursive: True;
        IncludeMasks: ["*.nxu", "*.o", "*.a", "*.res", "*.rsj"];
        ExcludeNames: "buildrtl.nxu;buildrtl.o";
    }
    CopyFile RTL_x86_64_iphonesim {
        Source: "build/forge-bootstrap/cross/x86_64-iphonesim/rtl";
        Destination: "build/forge-bootstrap/distribution/units/x86_64-iphonesim/rtl";
        Recursive: True;
        IncludeMasks: ["*.nxu", "*.o", "*.a", "*.res", "*.rsj"];
        ExcludeNames: "buildrtl.nxu;buildrtl.o";
    }
    CopyFile RTL_aarch64_iphonesim {
        Source: "build/forge-bootstrap/cross/aarch64-iphonesim/rtl";
        Destination: "build/forge-bootstrap/distribution/units/aarch64-iphonesim/rtl";
        Recursive: True;
        IncludeMasks: ["*.nxu", "*.o", "*.a", "*.res", "*.rsj"];
        ExcludeNames: "buildrtl.nxu;buildrtl.o";
    }
    CopyFile RTL_aarch64_ios {
        Source: "build/forge-bootstrap/cross/aarch64-ios/rtl";
        Destination: "build/forge-bootstrap/distribution/units/aarch64-ios/rtl";
        Recursive: True;
        IncludeMasks: ["*.nxu", "*.o", "*.a", "*.res", "*.rsj"];
        ExcludeNames: "buildrtl.nxu;buildrtl.o";
    }
    CopyFile BuildIdentity {
        Source: "build/forge-bootstrap/seed/build-identity.json";
        Destination: "build/forge-bootstrap/distribution/build-identity.json";
    }
    CopyFile RuntimePackageSDK {
        Source: "build/forge-bootstrap/package-sdk";
        Destination: "build/forge-bootstrap/distribution/package-sdk/x86_64-win64";
        Recursive: True;
        ExcludeNames: "work";
    }
    CopyFile ReleaseConfig {
        Source: "scripts/NexusFPC.Release.cfg";
        Destination: "build/forge-bootstrap/distribution/bin/x86_64-win64/fpc.cfg";
    }
    Run VerifyReleaseDistribution {
        Template: "../../nexus/projects/forge/templates/Run.mustache";
        Executable: "powershell.exe";
        Arguments: ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "tests/forge/Test-ReleaseDistribution.ps1", "-SourceRoot", "."];
    }
}
