dialect "../../../../nexus/projects/nxbuild/language/nxbuild.Language.nxscript";
module Projects "../../../../nexus/projects/nxbuild/Projects.nxscript";
module "../../../../nexus/projects/nxbuild/nxbuild.environment.nxscript";

Project NXProfilerTests {
    Id: "NXRP.CompilerTests.NXProfilerTests";
    Requires: [@Projects.NexusTest];
    RootDirectory: "../../../../nexus";
    OutputRoot: @Tools.OutputRoot + "/NXProfilerTests/" + @Tools.Native.Name;
    FPC Tests {
        CompilerPath: @Tools.Native.FPCCompiler;
        SourceFiles: [@Tools.NexusFPC.SourcePath + "/packages/nexusprofiler/tests/NXProfilerTests.lpr"];
        OutputPath: @NXProfilerTests.OutputRoot;
        RawOptions: ["-O2", "-Cr", "-Co"];
        Config Options { DisableDefaultConfigFiles: True; }
        Language Pascal { Mode: ObjFPC; }
        Assembler Native TargetOS[linux] { OutputFormat: "as-clang"; }
        Files Paths {
            CompilerUtilitiesPath: @Tools.Native.CompilerUtilitiesPath;
            UnitPaths: [
                @Tools.Native.RTLPath,
                @Tools.NexusFPC.SourcePath + "/packages/nexusprofiler/tests",
                @Tools.NexusFPC.SourcePath + "/packages/nexusprofiler/src"
            ];
        }
    }
}
