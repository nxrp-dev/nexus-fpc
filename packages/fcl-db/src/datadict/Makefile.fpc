#
# Makefile.fpc for SQL FCL db units
#

[package]
main=fcl-db

[require]
packages=fcl-base fcl-xml

[target]
units=fpdatadict fpdddiff fpdddbf fpddsqldb
units_linux=fpddregstd
units_darwin=fpddregstd
units_iphonesim=fpddregstd
units_win32=fpddregstd
units_aix=fpddregstd
rsts=fpdatadict fpddsqldb fpdddiff
rsts_linux=fpddregstd
rsts_darwin=fpddregstd
rsts_iphonesim=fpddregstd
rsts_win32=fpddregstd
rsts_aix=fpddregstd

[compiler]
options=-S2h

[install]
fpcpackage=y

[default]
fpcdir=../../../..

[rules]
.NOTPARALLEL:
