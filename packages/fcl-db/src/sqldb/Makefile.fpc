#
# Makefile.fpc for SQL FCL db units
#

[package]
main=fcl-db

[target]
dirs_linux=sqlite
dirs_darwin=sqlite
dirs_iphonesim=sqlite
dirs_win32=sqlite
dirs_win64=sqlite
dirs_wince=sqlite
dirs_aix=sqlite
units=sqldb
rsts=sqldb

[require]
packages=fcl-xml

[compiler]
options=-S2

[install]
fpcpackage=y

[default]
fpcdir=../../../..

[rules]
.NOTPARALLEL:
