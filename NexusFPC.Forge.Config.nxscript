module "NexusFPC.Forge.Targets.nxscript";

FPC CrossCompiler Build[Cross] {
    Template: "../../nexus/projects/forge/examples/FPC.mustache";
    Compiler: "build/forge-bootstrap/cycle3/ppcx64.exe";
    Source: ["build/forge-bootstrap/seed/source/pp.pas"];
    EntryPoint: "build/forge-bootstrap/seed/source/pp.pas";
    Output: @CrossTarget.Compiler;
    UnitOutput: @CrossTarget.Directory + "/compiler-units";
    UnitPaths: [
        "build/forge-bootstrap/cycle3/rtl64",
        "build/forge-bootstrap/seed/source/" + @CrossTarget.Architecture,
        "build/forge-bootstrap/seed/source/" + @CrossTarget.SharedBackend,
        "build/forge-bootstrap/seed/source/systems"
    ];
    IncludePaths: [
        "build/forge-bootstrap/seed/source",
        "build/forge-bootstrap/seed/source/" + @CrossTarget.Architecture,
        "build/forge-bootstrap/seed/source/" + @CrossTarget.SharedBackend,
        "build/forge-bootstrap/seed/source/systems"
    ];
    Defines: [@CrossTarget.Architecture];
    OptimizationLevel: 2;
    DisableDefaultConfigFiles: True;
}

FPC CrossRTL Build[Cross] TargetOS[linux] {
    Template: "../../nexus/projects/forge/examples/FPC.mustache";
    TargetOS: @CrossTarget.TargetOS;
    Assembler: "as-clang";
    UseLLD: True;
    Compiler: @CrossTarget.Compiler;
    UnitOutput: @CrossTarget.RTL;
    UnitPaths: [
        @CrossTarget.RTL,
        "build/forge-bootstrap/seed/rtl/linux", "build/forge-bootstrap/seed/rtl/unix", "build/forge-bootstrap/seed/rtl/inc", "build/forge-bootstrap/seed/rtl/objpas",
        "build/forge-bootstrap/seed/rtl/" + @CrossTarget.Architecture,
        "build/forge-bootstrap/seed/rtl/linux/" + @CrossTarget.Architecture
    ];
    IncludePaths: [
        "build/forge-bootstrap/seed/rtl/linux", "build/forge-bootstrap/seed/rtl/inc", "build/forge-bootstrap/seed/rtl/" + @CrossTarget.Architecture,
        "build/forge-bootstrap/seed/rtl/unix", "build/forge-bootstrap/seed/rtl/linux/" + @CrossTarget.Architecture,
        "build/forge-bootstrap/seed/rtl/objpas", "build/forge-bootstrap/seed/rtl/objpas/sysutils", "build/forge-bootstrap/seed/rtl/objpas/classes", "build/forge-bootstrap/seed/rtl/charmaps"
    ];
    DisableDefaultConfigFiles: True;
    GenerateReleaseUnitFiles: True;
}

Clang CrossAssembly Build[Cross] TargetOS[linux] {
    Template: "../../nexus/projects/forge/examples/Clang.mustache";
    SourceLanguage: "assembler";
    Target: @CrossTarget.Triple;
    CompileOnly: True;
}

FPC CrossRTL Build[Cross] TargetOS[win32, win64] {
    Template: "../../nexus/projects/forge/examples/FPC.mustache";
    TargetOS: @CrossTarget.TargetOS;
    Assembler: "as-clang";
    UseLLD: True;
    Compiler: @CrossTarget.Compiler;
    UnitOutput: @CrossTarget.RTL;
    UnitPaths: [
        @CrossTarget.RTL,
        @CrossTarget.RTLDirectory, "build/forge-bootstrap/seed/rtl/win", "build/forge-bootstrap/seed/rtl/inc", "build/forge-bootstrap/seed/rtl/objpas",
        "build/forge-bootstrap/seed/rtl/" + @CrossTarget.Architecture
    ];
    IncludePaths: [
        @CrossTarget.RTLDirectory, "build/forge-bootstrap/seed/rtl/inc", "build/forge-bootstrap/seed/rtl/" + @CrossTarget.Architecture,
        @CrossTarget.RTLDirectory + "/" + @CrossTarget.Architecture,
        "build/forge-bootstrap/seed/rtl/win", "build/forge-bootstrap/seed/rtl/win/wininc",
        "build/forge-bootstrap/seed/rtl/objpas", "build/forge-bootstrap/seed/rtl/objpas/sysutils", "build/forge-bootstrap/seed/rtl/objpas/classes", "build/forge-bootstrap/seed/rtl/charmaps"
    ];
    DisableDefaultConfigFiles: True;
    GenerateReleaseUnitFiles: True;
}

FPC CrossRTL Build[Cross] TargetOS[android] {
    PositionIndependentCode: True;
    CompilerUtilitiesPath: "C:/android/ndk/25.2.9519653/toolchains/llvm/prebuilt/windows-x86_64/bin";
    Template: "../../nexus/projects/forge/examples/FPC.mustache";
    TargetOS: @CrossTarget.TargetOS;
    Assembler: "as-clang";
    UseLLD: True;
    Compiler: @CrossTarget.Compiler;
    UnitOutput: @CrossTarget.RTL;
    UnitPaths: [
        @CrossTarget.RTL,
        "build/forge-bootstrap/seed/rtl/android", "build/forge-bootstrap/seed/rtl/linux", "build/forge-bootstrap/seed/rtl/unix", "build/forge-bootstrap/seed/rtl/inc", "build/forge-bootstrap/seed/rtl/objpas",
        "build/forge-bootstrap/seed/rtl/" + @CrossTarget.Architecture, "build/forge-bootstrap/seed/rtl/linux/" + @CrossTarget.Architecture
    ];
    IncludePaths: [
        "build/forge-bootstrap/seed/rtl/android", "build/forge-bootstrap/seed/rtl/inc", "build/forge-bootstrap/seed/rtl/" + @CrossTarget.Architecture,
        "build/forge-bootstrap/seed/rtl/unix", "build/forge-bootstrap/seed/rtl/android/" + @CrossTarget.Architecture, "build/forge-bootstrap/seed/rtl/linux",
        "build/forge-bootstrap/seed/rtl/linux/" + @CrossTarget.Architecture,
        "build/forge-bootstrap/seed/rtl/objpas", "build/forge-bootstrap/seed/rtl/objpas/sysutils", "build/forge-bootstrap/seed/rtl/objpas/classes", "build/forge-bootstrap/seed/rtl/charmaps"
    ];
    DisableDefaultConfigFiles: True;
    GenerateReleaseUnitFiles: True;
}

FPC CrossRTL Build[Cross] TargetOS[darwin, iphonesim, ios] {
    Template: "../../nexus/projects/forge/examples/FPC.mustache";
    TargetOS: @CrossTarget.TargetOS;
    Assembler: "as-clang";
    UseLLD: True;
    Compiler: @CrossTarget.Compiler;
    UnitOutput: @CrossTarget.RTL;
    UnitPaths: [
        @CrossTarget.RTL,
        "build/forge-bootstrap/seed/rtl/darwin", "build/forge-bootstrap/seed/rtl/bsd", "build/forge-bootstrap/seed/rtl/unix", "build/forge-bootstrap/seed/rtl/inc", "build/forge-bootstrap/seed/rtl/objpas",
        "build/forge-bootstrap/seed/rtl/" + @CrossTarget.Architecture
    ];
    IncludePaths: [
        "build/forge-bootstrap/seed/rtl/darwin", "build/forge-bootstrap/seed/rtl/inc", "build/forge-bootstrap/seed/rtl/" + @CrossTarget.Architecture,
        "build/forge-bootstrap/seed/rtl/unix", "build/forge-bootstrap/seed/rtl/bsd", "build/forge-bootstrap/seed/rtl/bsd/" + @CrossTarget.Architecture,
        "build/forge-bootstrap/seed/rtl/darwin/" + @CrossTarget.Architecture,
        "build/forge-bootstrap/seed/rtl/objpas", "build/forge-bootstrap/seed/rtl/objpas/sysutils", "build/forge-bootstrap/seed/rtl/objpas/classes", "build/forge-bootstrap/seed/rtl/charmaps"
    ];
    Defines: [FPC_USE_LIBC];
    DisableDefaultConfigFiles: True;
    GenerateReleaseUnitFiles: True;
}

Clang CrossAssembly Build[Cross] TargetOS[android] {
    AssemblerSymbols: ["CPU64=1"];
    Template: "../../nexus/projects/forge/examples/Clang.mustache";
    SourceLanguage: "assembler";
    Executable: "C:/android/ndk/25.2.9519653/toolchains/llvm/prebuilt/windows-x86_64/bin/clang.exe";
    Target: @CrossTarget.Triple;
    CompileOnly: True;
}
