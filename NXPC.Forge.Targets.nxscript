module "NXPC.Forge.Host.nxscript";

//
// Select both CPU and OS. Target data is imported by the operation configurations.

Environment CrossTarget Build[Cross] TargetCPU[i386] TargetOS[linux] {
    Architecture: "i386";
    SharedBackend: "x86";
    Directory: @BootstrapPaths.Root + "/cross/i386-linux";
    Compiler: @CrossTarget.Directory + "/nxpc-i386" + @CrossHost.Suffix;
    RTL: @CrossTarget.Directory + "/rtl";
    RTLDirectory: @BootstrapPaths.Root + "/seed/rtl/linux";
    TargetOS: "linux";
    Triple: "i386-unknown-linux-gnu";
    ExecutableSuffix: "";
}

Environment CrossTarget Build[Cross] TargetCPU[x86_64] TargetOS[linux] {
    Architecture: "x86_64";
    SharedBackend: "x86";
    Directory: @BootstrapPaths.Root + "/cross/x86_64-linux";
    Compiler: @CrossTarget.Directory + "/nxpc-x86_64" + @CrossHost.Suffix;
    RTL: @CrossTarget.Directory + "/rtl";
    RTLDirectory: @BootstrapPaths.Root + "/seed/rtl/linux";
    TargetOS: "linux";
    Triple: "x86_64-unknown-linux-gnu";
    ExecutableSuffix: "";
}

Environment CrossTarget Build[Cross] TargetCPU[aarch64] TargetOS[linux] {
    Architecture: "aarch64";
    SharedBackend: "armgen";
    Directory: @BootstrapPaths.Root + "/cross/aarch64-linux";
    Compiler: @CrossTarget.Directory + "/nxpc-aarch64" + @CrossHost.Suffix;
    RTL: @CrossTarget.Directory + "/rtl";
    RTLDirectory: @BootstrapPaths.Root + "/seed/rtl/linux";
    TargetOS: "linux";
    Triple: "aarch64-unknown-linux-gnu";
    ExecutableSuffix: "";
}

