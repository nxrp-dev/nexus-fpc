Group Cross Build[Cross] {
    DeletePath CleanCross {
        Path: @CrossTarget.Directory;
        Recursive: True;
    }
    CreateDirectory CrossCompilerUnits { Path: @CrossTarget.Directory + "/compiler-units"; }
    CreateDirectory CrossRTLUnits { Path: @CrossTarget.RTL; }
    FPC BuildCrossCompiler (CrossCompiler) {}

    Group LinuxRTL TargetOS[linux] {
        Clang BuildAbiTag (CrossAssembly) TargetCPU[x86_64] {
            Source: ["rtl/linux/x86_64/abitag.as"];
            Output: @CrossTarget.RTL + "/abitag.o";
        }
        Clang Buildprt0 (CrossAssembly) TargetCPU[aarch64] {
            Source: ["rtl/linux/aarch64/prt0.as"];
            Output: @CrossTarget.RTL + "/prt0.o";
        }
        Clang Builddllprt0 (CrossAssembly) TargetCPU[aarch64] {
            Source: ["rtl/linux/aarch64/dllprt0.as"];
            Output: @CrossTarget.RTL + "/dllprt0.o";
        }
        Clang Buildcprt0 (CrossAssembly) TargetCPU[aarch64] {
            Source: ["rtl/linux/aarch64/cprt0.as"];
            Output: @CrossTarget.RTL + "/cprt0.o";
        }
        FPC BuildCrossSystem (CrossRTL) {
            Source: ["rtl/linux/system.pp"];
            EntryPoint: "rtl/linux/system.pp";
            CompileSystemUnit: True;
            LabelAndGoto: True;
        }
        FPC BuildCrossObjPas (CrossRTL) {
            Source: ["rtl/objpas/objpas.pp"];
            EntryPoint: "rtl/objpas/objpas.pp";
        }
        FPC Build_si_prc (CrossRTL) TargetCPU[i386, x86_64] {
            Source: ["rtl/linux/si_prc.pp"];
            EntryPoint: "rtl/linux/si_prc.pp";
        }
        FPC Build_si_c (CrossRTL) TargetCPU[i386, x86_64] {
            Source: ["rtl/linux/si_c.pp"];
            EntryPoint: "rtl/linux/si_c.pp";
        }
        FPC Build_si_dll (CrossRTL) TargetCPU[i386, x86_64] {
            Source: ["rtl/linux/si_dll.pp"];
            EntryPoint: "rtl/linux/si_dll.pp";
        }
        FPC Build_si_c21 (CrossRTL) TargetCPU[i386] {
            Source: ["rtl/linux/si_c21.pp"];
            EntryPoint: "rtl/linux/si_c21.pp";
        }
        FPC Build_si_uc (CrossRTL) TargetCPU[i386] {
            Source: ["rtl/linux/si_uc.pp"];
            EntryPoint: "rtl/linux/si_uc.pp";
        }
        FPC BuildCrossIntrinsics (CrossRTL) {
            Source: ["rtl/" + @CrossTarget.Architecture + "/intrinsics.pp"];
            EntryPoint: "rtl/" + @CrossTarget.Architecture + "/intrinsics.pp";
        }
        FPC Build_fpintres (CrossRTL) {
            Source: ["rtl/inc/fpintres.pp"];
            EntryPoint: "rtl/inc/fpintres.pp";
        }
        FPC Build_uuchar (CrossRTL) {
            Source: ["rtl/inc/uuchar.pp"];
            EntryPoint: "rtl/inc/uuchar.pp";
        }
        FPC Build_unixtype (CrossRTL) {
            Source: ["rtl/unix/unixtype.pp"];
            EntryPoint: "rtl/unix/unixtype.pp";
        }
        FPC Build_ctypes (CrossRTL) {
            Source: ["rtl/inc/ctypes.pp"];
            EntryPoint: "rtl/inc/ctypes.pp";
        }
        FPC Build_baseunix (CrossRTL) {
            Source: ["rtl/unix/baseunix.pp"];
            EntryPoint: "rtl/unix/baseunix.pp";
        }
        FPC Build_strings (CrossRTL) {
            Source: ["rtl/inc/strings.pp"];
            EntryPoint: "rtl/inc/strings.pp";
        }
        FPC Build_macpas (CrossRTL) {
            Source: ["rtl/inc/macpas.pp"];
            EntryPoint: "rtl/inc/macpas.pp";
        }
        FPC Build_iso7185 (CrossRTL) {
            Source: ["rtl/inc/iso7185.pp"];
            EntryPoint: "rtl/inc/iso7185.pp";
        }
        FPC Build_extpas (CrossRTL) {
            Source: ["rtl/inc/extpas.pp"];
            EntryPoint: "rtl/inc/extpas.pp";
