//
// Native: /targets=Build:Bootstrap
// Cross:  /targets=Build:Cross,TargetCPU:aarch64,TargetOS:linux
// Tools:  /targets=Build:Tools (requires a completed Bootstrap)
// PackageSDK: /targets=Build:PackageSDK (requires a completed Bootstrap)
// Release: /targets=Build:Release (requires Bootstrap and the full Cross matrix)
//
// Bootstrap stages compiler/RTL sources, generates messages and tables, builds the Win32
// seed and native Win64 compiler, then verifies native generations two and three.
// Cross builds use that native compiler and target-filtered configurations.
// See NexusFPC.Forge.md for the retained targets and tool prerequisites.
// Bootstrap also builds the Win64 release tools. Other packages await owner selection.

dialect "../../nexus/projects/forge/language/Forge.nxscript";

module "NexusFPC.Forge.Config.nxscript";
module CompilerTables "NexusFPC.Forge.Tables.nxscript";
module ReleaseTools "NexusFPC.Forge.Tools.nxscript";
module RuntimePackageSDK "NexusFPC.Forge.PackageSDK.nxscript";
module ReleaseAssembly "NexusFPC.Forge.Release.nxscript";

Project Bootstrap Build[Bootstrap] {
    Id: "NXRP.FPC.Bootstrap";
    Outputs: [Compiler: "build/forge-bootstrap/cycle3/ppcx64.exe", RTL: "build/forge-bootstrap/cycle3/rtl64", Identity: "build/forge-bootstrap/seed/build-identity.json", Tools: "build/forge-bootstrap/tools/bin"];
    DeletePath CleanSeed { Path: "build/forge-bootstrap/seed"; Recursive: True; }
    CreateDirectory SeedBin {
        Path: "build/forge-bootstrap/seed/bin";
    }
    CreateDirectory SeedUnits {
        Path: "build/forge-bootstrap/seed/units32";
    }
    CopyFile StageCompiler {
        Source: "compiler";
        Destination: "build/forge-bootstrap/seed/source";
        Recursive: True;
        CleanDestination: True;
        IncludeMasks: ["*.pas", "*.inc", "*.dat"];
        ExcludeNames: "msgtxt.inc;msgidx.inc;a64att.inc;a64atts.inc;a64nop.inc;a64op.inc;a64tab.inc;ra64con.inc;ra64dwa.inc;ra64nor.inc;ra64num.inc;ra64rni.inc;ra64sri.inc;ra64sta.inc;ra64std.inc;ra64sup.inc;i386att.inc;i386atts.inc;i386int.inc;i386nop.inc;i386op.inc;i386prop.inc;i386tab.inc;r386ari.inc;r386att.inc;r386con.inc;r386dwrf.inc;r386int.inc;r386iri.inc;r386nasm.inc;r386nor.inc;r386nri.inc;r386num.inc;r386ot.inc;r386rni.inc;r386sri.inc;r386stab.inc;r386std.inc;r8664ari.inc;r8664att.inc;r8664con.inc;r8664dwrf.inc;r8664int.inc;r8664iri.inc;r8664nasm.inc;r8664nor.inc;r8664num.inc;r8664ot.inc;r8664rni.inc;r8664sri.inc;r8664stab.inc;r8664std.inc;x8664ats.inc;x8664att.inc;x8664int.inc;x8664nop.inc;x8664op.inc;x8664pro.inc;x8664tab.inc;cx86mminnr.inc;x86mmtype.inc;x86mmfirst.inc;x86mmsecond.inc;cpummprocs.inc;cpumminnr.inc";
    }
    CopyFile StageMetadataCompression {
        Source: "packages/paszlib/src";
        Destination: "build/forge-bootstrap/seed/dependencies/paszlib";
        Recursive: True;
        CleanDestination: True;
        IncludeMasks: ["*.pas", "*.inc"];
    }
    CopyFile StageMetadataHash {
        Source: "packages/hash/src";
        Destination: "build/forge-bootstrap/seed/dependencies/hash";
        Recursive: True;
        CleanDestination: True;
        IncludeMasks: ["*.pas", "*.inc"];
    }
    CopyFile StageRTL {
        Source: "rtl";
        Destination: "build/forge-bootstrap/seed/rtl";
        Recursive: True;
        CleanDestination: True;
        IncludeMasks: ["*.pas", "*.ppk", "*.inc", "*.as", "*.s", "*.asm", "*.h", "*.rc", "*.res", "*.def", "*.dat"];
        ExcludeNames: "units;cpummprocs.inc;cpumminnr.inc";
    }
    BuildIdentity CaptureBuildIdentity {
        Repository: ".";
        OutputDirectory: "build/forge-bootstrap/seed";
    }
    Group GenerateTables (CompilerTables) {}
    FPC BuildMessageGenerator {
        Template: "../../nexus/projects/forge/examples/FPC.mustache";
        Compiler: "C:/fpc/3.2.2/bin/i386-win32/ppc386.exe";
        Source: ["build/forge-bootstrap/seed/source/utils/msg2inc.pas"];
        EntryPoint: "build/forge-bootstrap/seed/source/utils/msg2inc.pas";
        Output: "build/forge-bootstrap/seed/bin/msg2inc.exe";
        UnitOutput: "build/forge-bootstrap/seed/units32";
        UnitPaths: ["C:/fpc/3.2.2/units/i386-win32/rtl"];
        DisableDefaultConfigFiles: True;
    }
    Msg2Inc GenerateMessages {
        Template: "../../nexus/projects/forge/examples/Msg2Inc.mustache";
        Executable: "build/forge-bootstrap/seed/bin/msg2inc.exe";
        Source: "compiler/msg/errore.msg";
        OutputPrefix: "build/forge-bootstrap/seed/source/msg";
        ConstantName: msg;
    }
    FPC BuildSeedCompiler {
        Template: "../../nexus/projects/forge/examples/FPC.mustache";
        Compiler: "C:/fpc/3.2.2/bin/i386-win32/ppc386.exe";
        Source: ["build/forge-bootstrap/seed/source/pp.pas"];
        EntryPoint: "build/forge-bootstrap/seed/source/pp.pas";
        Output: "build/forge-bootstrap/seed/bin/seed32.exe";
        UnitOutput: "build/forge-bootstrap/seed/units32";
        UnitPaths: [
            "C:/fpc/3.2.2/units/i386-win32/rtl",
            "build/forge-bootstrap/seed/source/x86_64",
            "build/forge-bootstrap/seed/source/x86",
            "build/forge-bootstrap/seed/source/systems",
            "build/forge-bootstrap/seed/dependencies/paszlib",
            "build/forge-bootstrap/seed/dependencies/hash"
        ];
        IncludePaths: [
            "build/forge-bootstrap/seed/source",
            "build/forge-bootstrap/seed/source/x86_64",
            "build/forge-bootstrap/seed/source/x86",
            "build/forge-bootstrap/seed/source/systems"
        ];
        Defines: [x86_64, REVINC, RELEASE];
        StripSymbols: True;
        OptimizationLevel: 2;
        DisableDefaultConfigFiles: True;
    }
    DeletePath CleanSeedRTL {
        Path: "build/forge-bootstrap/seed/rtl64";
        Recursive: True;
    }
    CreateDirectory SeedRTL {
        Path: "build/forge-bootstrap/seed/rtl64";
    }
    FPC BuildSeedSystem {
        Template: "../../nexus/projects/forge/examples/FPC.mustache";
        Compiler: "build/forge-bootstrap/seed/bin/seed32.exe";
        Source: ["build/forge-bootstrap/seed/rtl/win64/system.pas"];
        EntryPoint: "build/forge-bootstrap/seed/rtl/win64/system.pas";
        UnitOutput: "build/forge-bootstrap/seed/rtl64";
        IncludePaths: ["build/forge-bootstrap/seed/rtl/win64", "build/forge-bootstrap/seed/rtl/inc", "build/forge-bootstrap/seed/rtl/x86_64", "build/forge-bootstrap/seed/rtl/win64/x86_64", "build/forge-bootstrap/seed/rtl/win", "build/forge-bootstrap/seed/rtl/win/wininc"];
        ResponseFiles: ["build/forge-bootstrap/seed/build-options.cfg"];
        GenerateReleaseUnitFiles: True;
        OptimizationLevel: 2;
        DisableDefaultConfigFiles: True;
        CompileSystemUnit: True;
        LabelAndGoto: True;
    }
    FPC BuildSeedObjPas {
        Template: "../../nexus/projects/forge/examples/FPC.mustache";
        Compiler: "build/forge-bootstrap/seed/bin/seed32.exe";
        Source: ["build/forge-bootstrap/seed/rtl/objpas/objpas.pas"];
        EntryPoint: "build/forge-bootstrap/seed/rtl/objpas/objpas.pas";
        UnitOutput: "build/forge-bootstrap/seed/rtl64";
        UnitPaths: [
            "build/forge-bootstrap/seed/rtl64", "build/forge-bootstrap/seed/rtl/win", "build/forge-bootstrap/seed/rtl/inc",
            "build/forge-bootstrap/seed/rtl/objpas", "build/forge-bootstrap/seed/rtl/x86_64"
        ];
        IncludePaths: [
            "build/forge-bootstrap/seed/rtl/win64", "build/forge-bootstrap/seed/rtl/inc", "build/forge-bootstrap/seed/rtl/x86_64", "build/forge-bootstrap/seed/rtl/win64/x86_64", "build/forge-bootstrap/seed/rtl/win", "build/forge-bootstrap/seed/rtl/win/wininc",
            "build/forge-bootstrap/seed/rtl/objpas", "build/forge-bootstrap/seed/rtl/objpas/sysutils", "build/forge-bootstrap/seed/rtl/objpas/classes"
        ];
        ResponseFiles: ["build/forge-bootstrap/seed/build-options.cfg"];
        GenerateReleaseUnitFiles: True;
        OptimizationLevel: 2;
        DisableDefaultConfigFiles: True;
    }
    FPC BuildSeedWindows {
        Template: "../../nexus/projects/forge/examples/FPC.mustache";
        Compiler: "build/forge-bootstrap/seed/bin/seed32.exe";
        Source: ["build/forge-bootstrap/seed/rtl/win64/windows.pas"];
        EntryPoint: "build/forge-bootstrap/seed/rtl/win64/windows.pas";
        UnitOutput: "build/forge-bootstrap/seed/rtl64";
        UnitPaths: [
            "build/forge-bootstrap/seed/rtl64", "build/forge-bootstrap/seed/rtl/win", "build/forge-bootstrap/seed/rtl/inc",
            "build/forge-bootstrap/seed/rtl/objpas", "build/forge-bootstrap/seed/rtl/x86_64"
        ];
        IncludePaths: [
            "build/forge-bootstrap/seed/rtl/win64", "build/forge-bootstrap/seed/rtl/inc", "build/forge-bootstrap/seed/rtl/x86_64", "build/forge-bootstrap/seed/rtl/win64/x86_64", "build/forge-bootstrap/seed/rtl/win", "build/forge-bootstrap/seed/rtl/win/wininc",
            "build/forge-bootstrap/seed/rtl/objpas", "build/forge-bootstrap/seed/rtl/objpas/sysutils", "build/forge-bootstrap/seed/rtl/objpas/classes"
        ];
        ResponseFiles: ["build/forge-bootstrap/seed/build-options.cfg"];
        GenerateReleaseUnitFiles: True;
        OptimizationLevel: 2;
        DisableDefaultConfigFiles: True;
    }
    FPC BuildSeedSysUtils {
        Template: "../../nexus/projects/forge/examples/FPC.mustache";
        Compiler: "build/forge-bootstrap/seed/bin/seed32.exe";
        Source: ["build/forge-bootstrap/seed/rtl/win/sysutils.pas"];
        EntryPoint: "build/forge-bootstrap/seed/rtl/win/sysutils.pas";
        UnitOutput: "build/forge-bootstrap/seed/rtl64";
        UnitPaths: [
            "build/forge-bootstrap/seed/rtl64", "build/forge-bootstrap/seed/rtl/win", "build/forge-bootstrap/seed/rtl/inc",
            "build/forge-bootstrap/seed/rtl/objpas", "build/forge-bootstrap/seed/rtl/x86_64"
        ];
        IncludePaths: [
            "build/forge-bootstrap/seed/rtl/win64", "build/forge-bootstrap/seed/rtl/inc", "build/forge-bootstrap/seed/rtl/x86_64", "build/forge-bootstrap/seed/rtl/win64/x86_64", "build/forge-bootstrap/seed/rtl/win", "build/forge-bootstrap/seed/rtl/win/wininc",
            "build/forge-bootstrap/seed/rtl/objpas", "build/forge-bootstrap/seed/rtl/objpas/sysutils", "build/forge-bootstrap/seed/rtl/objpas/classes"
        ];
        ResponseFiles: ["build/forge-bootstrap/seed/build-options.cfg"];
        GenerateReleaseUnitFiles: True;
        OptimizationLevel: 2;
        DisableDefaultConfigFiles: True;
    }
    FPC BuildSeedRTL {
        Template: "../../nexus/projects/forge/examples/FPC.mustache";
        Compiler: "build/forge-bootstrap/seed/bin/seed32.exe";
        Source: ["build/forge-bootstrap/seed/rtl/win64/buildrtl.pas"];
        EntryPoint: "build/forge-bootstrap/seed/rtl/win64/buildrtl.pas";
        UnitOutput: "build/forge-bootstrap/seed/rtl64";
        UnitPaths: [
            "build/forge-bootstrap/seed/rtl64", "build/forge-bootstrap/seed/rtl/win", "build/forge-bootstrap/seed/rtl/inc",
            "build/forge-bootstrap/seed/rtl/objpas", "build/forge-bootstrap/seed/rtl/x86_64"
        ];
        IncludePaths: [
            "build/forge-bootstrap/seed/rtl/win64", "build/forge-bootstrap/seed/rtl/inc", "build/forge-bootstrap/seed/rtl/x86_64", "build/forge-bootstrap/seed/rtl/win64/x86_64", "build/forge-bootstrap/seed/rtl/win", "build/forge-bootstrap/seed/rtl/win/wininc",
            "build/forge-bootstrap/seed/rtl/objpas", "build/forge-bootstrap/seed/rtl/objpas/sysutils", "build/forge-bootstrap/seed/rtl/objpas/classes"
        ];
        ResponseFiles: ["build/forge-bootstrap/seed/build-options.cfg"];
        GenerateReleaseUnitFiles: True;
        OptimizationLevel: 2;
        DisableDefaultConfigFiles: True;
    }
    FPC BuildSeedUUChar {
        Template: "../../nexus/projects/forge/examples/FPC.mustache";
        Compiler: "build/forge-bootstrap/seed/bin/seed32.exe";
        Source: ["build/forge-bootstrap/seed/rtl/inc/uuchar.pas"];
        EntryPoint: "build/forge-bootstrap/seed/rtl/inc/uuchar.pas";
        UnitOutput: "build/forge-bootstrap/seed/rtl64";
        UnitPaths: [
            "build/forge-bootstrap/seed/rtl64", "build/forge-bootstrap/seed/rtl/win", "build/forge-bootstrap/seed/rtl/inc",
            "build/forge-bootstrap/seed/rtl/objpas", "build/forge-bootstrap/seed/rtl/x86_64"
        ];
        IncludePaths: [
            "build/forge-bootstrap/seed/rtl/win64", "build/forge-bootstrap/seed/rtl/inc", "build/forge-bootstrap/seed/rtl/x86_64", "build/forge-bootstrap/seed/rtl/win64/x86_64", "build/forge-bootstrap/seed/rtl/win", "build/forge-bootstrap/seed/rtl/win/wininc",
            "build/forge-bootstrap/seed/rtl/objpas", "build/forge-bootstrap/seed/rtl/objpas/sysutils", "build/forge-bootstrap/seed/rtl/objpas/classes"
        ];
        ResponseFiles: ["build/forge-bootstrap/seed/build-options.cfg"];
        GenerateReleaseUnitFiles: True;
        OptimizationLevel: 2;
        DisableDefaultConfigFiles: True;
    }
    FPC BuildSeedMacPas {
        Template: "../../nexus/projects/forge/examples/FPC.mustache";
        Compiler: "build/forge-bootstrap/seed/bin/seed32.exe";
        Source: ["build/forge-bootstrap/seed/rtl/inc/macpas.pas"];
        EntryPoint: "build/forge-bootstrap/seed/rtl/inc/macpas.pas";
        UnitOutput: "build/forge-bootstrap/seed/rtl64";
        UnitPaths: [
            "build/forge-bootstrap/seed/rtl64", "build/forge-bootstrap/seed/rtl/win", "build/forge-bootstrap/seed/rtl/inc",
            "build/forge-bootstrap/seed/rtl/objpas", "build/forge-bootstrap/seed/rtl/x86_64"
        ];
        IncludePaths: [
            "build/forge-bootstrap/seed/rtl/win64", "build/forge-bootstrap/seed/rtl/inc", "build/forge-bootstrap/seed/rtl/x86_64", "build/forge-bootstrap/seed/rtl/win64/x86_64", "build/forge-bootstrap/seed/rtl/win", "build/forge-bootstrap/seed/rtl/win/wininc",
            "build/forge-bootstrap/seed/rtl/objpas", "build/forge-bootstrap/seed/rtl/objpas/sysutils", "build/forge-bootstrap/seed/rtl/objpas/classes"
        ];
        ResponseFiles: ["build/forge-bootstrap/seed/build-options.cfg"];
        GenerateReleaseUnitFiles: True;
        OptimizationLevel: 2;
        DisableDefaultConfigFiles: True;
    }
    FPC BuildSeedISO7185 {
        Template: "../../nexus/projects/forge/examples/FPC.mustache";
        Compiler: "build/forge-bootstrap/seed/bin/seed32.exe";
        Source: ["build/forge-bootstrap/seed/rtl/inc/iso7185.pas"];
        EntryPoint: "build/forge-bootstrap/seed/rtl/inc/iso7185.pas";
        UnitOutput: "build/forge-bootstrap/seed/rtl64";
        UnitPaths: [
            "build/forge-bootstrap/seed/rtl64", "build/forge-bootstrap/seed/rtl/win", "build/forge-bootstrap/seed/rtl/inc",
            "build/forge-bootstrap/seed/rtl/objpas", "build/forge-bootstrap/seed/rtl/x86_64"
        ];
        IncludePaths: [
            "build/forge-bootstrap/seed/rtl/win64", "build/forge-bootstrap/seed/rtl/inc", "build/forge-bootstrap/seed/rtl/x86_64", "build/forge-bootstrap/seed/rtl/win64/x86_64", "build/forge-bootstrap/seed/rtl/win", "build/forge-bootstrap/seed/rtl/win/wininc",
            "build/forge-bootstrap/seed/rtl/objpas", "build/forge-bootstrap/seed/rtl/objpas/sysutils", "build/forge-bootstrap/seed/rtl/objpas/classes"
        ];
        ResponseFiles: ["build/forge-bootstrap/seed/build-options.cfg"];
        GenerateReleaseUnitFiles: True;
        OptimizationLevel: 2;
        DisableDefaultConfigFiles: True;
    }
    FPC BuildSeedCodePages {
        Template: "../../nexus/projects/forge/examples/FPC.mustache";
        Compiler: "build/forge-bootstrap/seed/bin/seed32.exe";
        Source: ["build/forge-bootstrap/seed/rtl/charmaps/cpall.pas"];
        EntryPoint: "build/forge-bootstrap/seed/rtl/charmaps/cpall.pas";
        UnitOutput: "build/forge-bootstrap/seed/rtl64";
        UnitPaths: [
            "build/forge-bootstrap/seed/rtl64", "build/forge-bootstrap/seed/rtl/win", "build/forge-bootstrap/seed/rtl/inc",
            "build/forge-bootstrap/seed/rtl/objpas", "build/forge-bootstrap/seed/rtl/x86_64"
        ];
        IncludePaths: [
            "build/forge-bootstrap/seed/rtl/win64", "build/forge-bootstrap/seed/rtl/inc", "build/forge-bootstrap/seed/rtl/x86_64", "build/forge-bootstrap/seed/rtl/win64/x86_64", "build/forge-bootstrap/seed/rtl/win", "build/forge-bootstrap/seed/rtl/win/wininc",
            "build/forge-bootstrap/seed/rtl/objpas", "build/forge-bootstrap/seed/rtl/objpas/sysutils", "build/forge-bootstrap/seed/rtl/objpas/classes", "build/forge-bootstrap/seed/rtl/charmaps"
        ];
        ResponseFiles: ["build/forge-bootstrap/seed/build-options.cfg"];
        GenerateReleaseUnitFiles: True;
        OptimizationLevel: 2;
        DisableDefaultConfigFiles: True;
    }
    FPC BuildSeedLineInfo {
        Template: "../../nexus/projects/forge/examples/FPC.mustache";
        Compiler: "build/forge-bootstrap/seed/bin/seed32.exe";
        Source: ["build/forge-bootstrap/seed/rtl/inc/lineinfo.pas"];
        EntryPoint: "build/forge-bootstrap/seed/rtl/inc/lineinfo.pas";
        UnitOutput: "build/forge-bootstrap/seed/rtl64";
        UnitPaths: [
            "build/forge-bootstrap/seed/rtl64", "build/forge-bootstrap/seed/rtl/win", "build/forge-bootstrap/seed/rtl/inc",
            "build/forge-bootstrap/seed/rtl/objpas", "build/forge-bootstrap/seed/rtl/x86_64"
        ];
        IncludePaths: [
            "build/forge-bootstrap/seed/rtl/win64", "build/forge-bootstrap/seed/rtl/inc", "build/forge-bootstrap/seed/rtl/x86_64", "build/forge-bootstrap/seed/rtl/win64/x86_64", "build/forge-bootstrap/seed/rtl/win", "build/forge-bootstrap/seed/rtl/win/wininc",
            "build/forge-bootstrap/seed/rtl/objpas", "build/forge-bootstrap/seed/rtl/objpas/sysutils", "build/forge-bootstrap/seed/rtl/objpas/classes"
        ];
        ResponseFiles: ["build/forge-bootstrap/seed/build-options.cfg"];
        GenerateReleaseUnitFiles: True;
        OptimizationLevel: 2;
        DisableDefaultConfigFiles: True;
    }
    FPC BuildSeedDwarf {
        Template: "../../nexus/projects/forge/examples/FPC.mustache";
        Compiler: "build/forge-bootstrap/seed/bin/seed32.exe";
        Source: ["build/forge-bootstrap/seed/rtl/inc/lnfodwrf.pas"];
        EntryPoint: "build/forge-bootstrap/seed/rtl/inc/lnfodwrf.pas";
        UnitOutput: "build/forge-bootstrap/seed/rtl64";
        UnitPaths: [
            "build/forge-bootstrap/seed/rtl64", "build/forge-bootstrap/seed/rtl/win", "build/forge-bootstrap/seed/rtl/inc",
            "build/forge-bootstrap/seed/rtl/objpas", "build/forge-bootstrap/seed/rtl/x86_64"
        ];
        IncludePaths: [
            "build/forge-bootstrap/seed/rtl/win64", "build/forge-bootstrap/seed/rtl/inc", "build/forge-bootstrap/seed/rtl/x86_64", "build/forge-bootstrap/seed/rtl/win64/x86_64", "build/forge-bootstrap/seed/rtl/win", "build/forge-bootstrap/seed/rtl/win/wininc",
            "build/forge-bootstrap/seed/rtl/objpas", "build/forge-bootstrap/seed/rtl/objpas/sysutils", "build/forge-bootstrap/seed/rtl/objpas/classes"
        ];
        ResponseFiles: ["build/forge-bootstrap/seed/build-options.cfg"];
        GenerateReleaseUnitFiles: True;
        OptimizationLevel: 2;
        DisableDefaultConfigFiles: True;
    }
    FPC BuildSeedIntrinsics {
        Template: "../../nexus/projects/forge/examples/FPC.mustache";
        Compiler: "build/forge-bootstrap/seed/bin/seed32.exe";
        Source: ["build/forge-bootstrap/seed/rtl/x86_64/intrinsics.pas"];
        EntryPoint: "build/forge-bootstrap/seed/rtl/x86_64/intrinsics.pas";
        UnitOutput: "build/forge-bootstrap/seed/rtl64";
        UnitPaths: [
            "build/forge-bootstrap/seed/rtl64", "build/forge-bootstrap/seed/rtl/win", "build/forge-bootstrap/seed/rtl/inc",
            "build/forge-bootstrap/seed/rtl/objpas", "build/forge-bootstrap/seed/rtl/x86_64"
        ];
        IncludePaths: [
            "build/forge-bootstrap/seed/rtl/win64", "build/forge-bootstrap/seed/rtl/inc", "build/forge-bootstrap/seed/rtl/x86_64", "build/forge-bootstrap/seed/rtl/win64/x86_64", "build/forge-bootstrap/seed/rtl/win", "build/forge-bootstrap/seed/rtl/win/wininc",
            "build/forge-bootstrap/seed/rtl/objpas", "build/forge-bootstrap/seed/rtl/objpas/sysutils", "build/forge-bootstrap/seed/rtl/objpas/classes"
        ];
        ResponseFiles: ["build/forge-bootstrap/seed/build-options.cfg"];
        GenerateReleaseUnitFiles: True;
        OptimizationLevel: 2;
        DisableDefaultConfigFiles: True;
    }
    DeletePath CleanNativeSeedUnits {
        Path: "build/forge-bootstrap/seed/units64";
        Recursive: True;
    }
    CreateDirectory NativeSeedUnits {
        Path: "build/forge-bootstrap/seed/units64";
    }
    FPC BuildNativeSeedCompiler {
        Template: "../../nexus/projects/forge/examples/FPC.mustache";
        Compiler: "build/forge-bootstrap/seed/bin/seed32.exe";
        Source: ["build/forge-bootstrap/seed/source/pp.pas"];
        EntryPoint: "build/forge-bootstrap/seed/source/pp.pas";
        Output: "build/forge-bootstrap/seed/bin/ppcx64.exe";
        UnitOutput: "build/forge-bootstrap/seed/units64";
        UnitPaths: [
            "build/forge-bootstrap/seed/rtl64",
            "build/forge-bootstrap/seed/source/x86_64",
            "build/forge-bootstrap/seed/source/x86",
            "build/forge-bootstrap/seed/source/systems",
            "build/forge-bootstrap/seed/dependencies/paszlib",
            "build/forge-bootstrap/seed/dependencies/hash"
        ];
        IncludePaths: [
            "build/forge-bootstrap/seed/source",
            "build/forge-bootstrap/seed/source/x86_64",
            "build/forge-bootstrap/seed/source/x86",
            "build/forge-bootstrap/seed/source/systems"
        ];
        Defines: [x86_64, REVINC, RELEASE];
        StripSymbols: True;
        OptimizationLevel: 2;
        ResponseFiles: ["build/forge-bootstrap/seed/build-options.cfg"];
        GenerateReleaseUnitFiles: True;
        DisableDefaultConfigFiles: True;
    }
    // Native generation 1 rebuilds the RTL and compiler with the preceding compiler.
    DeletePath CleanCycle1 { Path: "build/forge-bootstrap/cycle1"; Recursive: True; }
    CreateDirectory Cycle1RTL { Path: "build/forge-bootstrap/cycle1/rtl64"; }
    CreateDirectory Cycle1Units { Path: "build/forge-bootstrap/cycle1/units64"; }
    FPC BuildCycle1System {
        Template: "../../nexus/projects/forge/examples/FPC.mustache";
        Compiler: "build/forge-bootstrap/seed/bin/ppcx64.exe";
        Source: ["build/forge-bootstrap/seed/rtl/win64/system.pas"];
        EntryPoint: "build/forge-bootstrap/seed/rtl/win64/system.pas";
        UnitOutput: "build/forge-bootstrap/cycle1/rtl64";
        IncludePaths: ["build/forge-bootstrap/seed/rtl/win64", "build/forge-bootstrap/seed/rtl/inc", "build/forge-bootstrap/seed/rtl/x86_64", "build/forge-bootstrap/seed/rtl/win64/x86_64", "build/forge-bootstrap/seed/rtl/win", "build/forge-bootstrap/seed/rtl/win/wininc"];
        ResponseFiles: ["build/forge-bootstrap/seed/build-options.cfg"];
        GenerateReleaseUnitFiles: True;
        OptimizationLevel: 2;
        DisableDefaultConfigFiles: True;
        CompileSystemUnit: True;
        LabelAndGoto: True;
    }
    FPC BuildCycle1ObjPas {
        Template: "../../nexus/projects/forge/examples/FPC.mustache";
        Compiler: "build/forge-bootstrap/seed/bin/ppcx64.exe";
        Source: ["build/forge-bootstrap/seed/rtl/objpas/objpas.pas"];
        EntryPoint: "build/forge-bootstrap/seed/rtl/objpas/objpas.pas";
        UnitOutput: "build/forge-bootstrap/cycle1/rtl64";
        UnitPaths: [
            "build/forge-bootstrap/cycle1/rtl64", "build/forge-bootstrap/seed/rtl/win", "build/forge-bootstrap/seed/rtl/inc",
            "build/forge-bootstrap/seed/rtl/objpas", "build/forge-bootstrap/seed/rtl/x86_64"
