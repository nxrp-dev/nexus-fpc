Project Tools Build[Tools] {
    Id: "NXRP.FPC.Tools";
    Outputs: [Bin: "build/forge-bootstrap/tools/bin", Driver: "build/forge-bootstrap/tools/bin/fpc.exe", ResourceCompiler: "build/forge-bootstrap/tools/bin/fpcres.exe"];
    Group BuildReleaseTools (ReleaseTools) {}
}

Project Release Build[Release] {
    Id: "NXRP.FPC.Release";
    Outputs: [Directory: "build/forge-bootstrap/distribution", Bin: "build/forge-bootstrap/distribution/bin/x86_64-win64", Config: "build/forge-bootstrap/distribution/bin/x86_64-win64/fpc.cfg", Identity: "build/forge-bootstrap/distribution/build-identity.json", PackageSDK: "build/forge-bootstrap/distribution/package-sdk/x86_64-win64"];
    Group BuildRuntimePackageSDK (RuntimePackageSDK) {}
    Group AssembleRelease (ReleaseAssembly) {}
}

Project PackageSDK Build[PackageSDK] {
    Id: "NXRP.FPC.PackageSDK";
    Outputs: [Directory: "build/forge-bootstrap/package-sdk", Manifest: "build/forge-bootstrap/package-sdk/sdk.json", Packages: "build/forge-bootstrap/package-sdk/packages", Units: "build/forge-bootstrap/package-sdk/units"];
    Group BuildRuntimePackageSDK (RuntimePackageSDK) {}
}

Project Cross Build[Cross] {
    Id: "NXRP.FPC.Cross";
    Outputs: [Compiler: @CrossTarget.Compiler, RTL: @CrossTarget.RTL];
    DeletePath CleanCross {
        Path: @CrossTarget.Directory;
        Recursive: True;
    }
    CreateDirectory CrossCompilerUnits { Path: @CrossTarget.Directory + "/compiler-units"; }
    CreateDirectory CrossRTLUnits { Path: @CrossTarget.RTL; }
