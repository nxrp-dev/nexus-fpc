    }
    FPC BuildCycle1LineInfo {
        Template: "../../nexus/projects/forge/examples/FPC.mustache";
        Compiler: "build/forge-bootstrap/seed/bin/ppcx64.exe";
        Source: ["rtl/inc/lineinfo.pp"];
        EntryPoint: "rtl/inc/lineinfo.pp";
        UnitOutput: "build/forge-bootstrap/cycle1/rtl64";
        UnitPaths: [
            "build/forge-bootstrap/cycle1/rtl64", "rtl/win", "rtl/inc",
            "rtl/objpas", "rtl/x86_64"
        ];
        IncludePaths: [
            "rtl/win64", "rtl/inc", "rtl/x86_64", "rtl/win64/x86_64", "rtl/win", "rtl/win/wininc",
            "rtl/objpas", "rtl/objpas/sysutils", "rtl/objpas/classes"
        ];
        DisableDefaultConfigFiles: True;
    }
    FPC BuildCycle1Dwarf {
        Template: "../../nexus/projects/forge/examples/FPC.mustache";
        Compiler: "build/forge-bootstrap/seed/bin/ppcx64.exe";
        Source: ["rtl/inc/lnfodwrf.pp"];
        EntryPoint: "rtl/inc/lnfodwrf.pp";
        UnitOutput: "build/forge-bootstrap/cycle1/rtl64";
        UnitPaths: [
            "build/forge-bootstrap/cycle1/rtl64", "rtl/win", "rtl/inc",
            "rtl/objpas", "rtl/x86_64"
        ];
        IncludePaths: [
            "rtl/win64", "rtl/inc", "rtl/x86_64", "rtl/win64/x86_64", "rtl/win", "rtl/win/wininc",
            "rtl/objpas", "rtl/objpas/sysutils", "rtl/objpas/classes"
        ];
        DisableDefaultConfigFiles: True;
    }
    FPC BuildCycle1Intrinsics {
        Template: "../../nexus/projects/forge/examples/FPC.mustache";
        Compiler: "build/forge-bootstrap/seed/bin/ppcx64.exe";
        Source: ["rtl/x86_64/intrinsics.pp"];
        EntryPoint: "rtl/x86_64/intrinsics.pp";
        UnitOutput: "build/forge-bootstrap/cycle1/rtl64";
        UnitPaths: [
            "build/forge-bootstrap/cycle1/rtl64", "rtl/win", "rtl/inc",
            "rtl/objpas", "rtl/x86_64"
        ];
        IncludePaths: [
            "rtl/win64", "rtl/inc", "rtl/x86_64", "rtl/win64/x86_64", "rtl/win", "rtl/win/wininc",
            "rtl/objpas", "rtl/objpas/sysutils", "rtl/objpas/classes"
        ];
        DisableDefaultConfigFiles: True;
    }
    FPC BuildCycle1Compiler {
        Template: "../../nexus/projects/forge/examples/FPC.mustache";
        Compiler: "build/forge-bootstrap/seed/bin/ppcx64.exe";
        Source: ["build/forge-bootstrap/seed/source/pp.pas"];
        EntryPoint: "build/forge-bootstrap/seed/source/pp.pas";
        Output: "build/forge-bootstrap/cycle1/ppcx64.exe";
        UnitOutput: "build/forge-bootstrap/cycle1/units64";
        UnitPaths: [
            "build/forge-bootstrap/cycle1/rtl64",
            "build/forge-bootstrap/seed/source/x86_64",
            "build/forge-bootstrap/seed/source/x86",
            "build/forge-bootstrap/seed/source/systems"
        ];
        IncludePaths: [
            "build/forge-bootstrap/seed/source",
            "build/forge-bootstrap/seed/source/x86_64",
            "build/forge-bootstrap/seed/source/x86",
            "build/forge-bootstrap/seed/source/systems"
        ];
        Defines: [x86_64];
        OptimizationLevel: 2;
        DisableDefaultConfigFiles: True;
    }
    // Native generation 2 rebuilds the RTL and compiler with the preceding compiler.
    DeletePath CleanCycle2 { Path: "build/forge-bootstrap/cycle2"; Recursive: True; }
    CreateDirectory Cycle2RTL { Path: "build/forge-bootstrap/cycle2/rtl64"; }
    CreateDirectory Cycle2Units { Path: "build/forge-bootstrap/cycle2/units64"; }
    FPC BuildCycle2System {
        Template: "../../nexus/projects/forge/examples/FPC.mustache";
        Compiler: "build/forge-bootstrap/cycle1/ppcx64.exe";
